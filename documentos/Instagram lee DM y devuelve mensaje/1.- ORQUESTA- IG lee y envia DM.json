    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n  const entry = data.body?.entry?.[0] || {};\n  \n  // Detección de los dos posibles arrays\n  const messagingEvent = entry.messaging?.[0];\n  const changeEvent = entry.changes?.[0];\n\n  // Estructura base unificada con todos los campos\n  const result = {\n    eventType: 'unknown',\n    senderId: null,\n    username: null,\n    recipientId: null,\n    text: null,\n    timestamp: null,\n    // Específicos de DM\n    messageId: null,\n    // Específicos de Comentarios / Reels\n    commentId: null,\n    mediaId: null,\n    mediaProductType: null,\n    field: null\n  };\n\n  if (messagingEvent) {\n    // 1. Mensaje Directo (DM)\n    result.eventType = 'direct_message';\n    result.senderId = messagingEvent.sender?.id || null;\n    result.recipientId = messagingEvent.recipient?.id || entry.id || null;\n    result.text = messagingEvent.message?.text || null;\n    result.messageId = messagingEvent.message?.mid || null;\n    result.timestamp = messagingEvent.timestamp || entry.time || null;\n\n  } else if (changeEvent) {\n    // 2. Comentario en Reel / Publicación\n    const value = changeEvent.value || {};\n    \n    result.eventType = 'reel_comment';\n    result.field = changeEvent.field || 'comments';\n    result.senderId = value.from?.id || null;\n    result.username = value.from?.username || null;\n    result.recipientId = entry.id || null;\n    result.text = value.text || null;\n    result.commentId = value.id || null;\n    result.mediaId = value.media?.id || null;\n    result.mediaProductType = value.media?.media_product_type || null;\n    \n    // Normalización de timestamp: si viene en segundos (10 dígitos), se convierte a ms\n    const rawTime = entry.time || null;\n    result.timestamp = (rawTime && rawTime < 10000000000) ? rawTime * 1000 : rawTime;\n  }\n\n  return { json: result };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -5392,
        2320
      ],
      "id": "d21070d9-f791-42b5-b1c9-b6310a9754ec",
      "name": "Extraer comentarios1"
    },
    {
      "parameters": {
        "jsCode": "// 1. Obtiene el texto de forma segura, garantizando que siempre sea un string\nlet rawText = '';\ntry {\n  rawText = $('Extraer comentarios1').first()?.json?.text || $json.text || '';\n} catch (e) {\n  rawText = $json.text || '';\n}\n\n// Forzamos conversión a string para que null o undefined se conviertan en cadena vacía\nconst textoEntrada = String(rawText || '').trim();\n\n// 2. Si no hay texto, devolvemos sin fallar\nif (!textoEntrada) {\n  return {\n    json: {\n      ...$json,\n      PETICION: null\n    }\n  };\n}\n\n// 3. Normaliza quitando tildes/acentos (guía -> guia, vídeo -> video, misión -> mision)\nconst textoLimpio = textoEntrada\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '');\n\n// 4. Busca coincidencia de palabra completa (case-insensitive)\nconst match = textoLimpio.match(/\\b(guia|video|seguridad|mision)\\b/i);\n\n// 5. Mapea la coincidencia a su formato oficial en mayúsculas\nlet peticion = null;\nif (match) {\n  const encontrada = match[1].toLowerCase();\n  if (encontrada === 'guia') peticion = 'GUIA';\n  else if (encontrada === 'video') peticion = 'VIDEO';\n  else if (encontrada === 'seguridad') peticion = 'SEGURIDAD';\n  else if (encontrada === 'mision') peticion = 'MISION';\n}\n\nreturn {\n  json: {\n    ...$json,\n    PETICION: peticion\n  }\n};"
      },
