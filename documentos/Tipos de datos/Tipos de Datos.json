      "name": "Listas"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      numero1: 10,\n      numero2: 5,\n      suma: 10 + 5,       // 15\n      resta: 10 - 5,      // 5\n      multiplicacion: 10 * 5, // 50\n      division: 10 / 5,   // 2\n      decimal: 10 / 3     // 3.333...\n    }\n  }\n];\n\n"
