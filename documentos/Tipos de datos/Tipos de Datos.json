      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      texto_numero: \"123\",     // string\n      numero_real: 123,        // number\n      suma_texto: \"123\" + 10,  // concatena → \"12310\"\n      suma_numero: 123 + 10,   // suma → 133\n      // Cómo convertir string a número:\n      suma_tras_convertir: Number(\"123\") + 10 // → 133\n    }\n  }\n];\n\n"
